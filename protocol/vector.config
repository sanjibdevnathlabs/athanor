# vector.config — athanor vector layer configuration (committed defaults).
#
# Athanor owns embedding now (SocratiCode removed). The embedding model is NOT
# pinned — it is whatever you set here. Changing the model requires a rebuild:
#   bash .claude/hooks/lib/kb-reindex.sh --rebuild
# because existing vectors are model-specific (and dim-specific).
#
# Precedence: environment variable > this file > built-in default.
# Every key below is overridable by an env var of the same name.
#
# Format: KEY=VALUE, one per line. '#' comments and blank lines ignored.
# No quoting, no interpolation — values are taken literally to end-of-line.

# ---- Driver (which vector DB) ----
# Supported: qdrant. Registered-but-stub: chromadb.
VEC_DRIVER=qdrant

# ---- Collection (single collection, artifact stored in payload) ----
VEC_COLLECTION=athanor_kb
VEC_DISTANCE=Cosine

# ---- Qdrant driver ----
VEC_QDRANT_URL=http://localhost:6333
# VEC_QDRANT_API_KEY=        # uncomment + set for secured/cloud Qdrant

# ---- ChromaDB driver (stub — not yet implemented) ----
# VEC_CHROMA_URL=http://localhost:8000

# ---- Embedding provider ----
# Supported: ollama.
VEC_EMBED_PROVIDER=ollama
VEC_EMBED_URL=http://localhost:11434
# Any model your provider serves. Default is a small local Ollama model.
VEC_EMBED_MODEL=qwen3-embedding:0.6b
